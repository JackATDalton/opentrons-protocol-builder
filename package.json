{
  "name": "opentrons-protocols",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Protocol generators, pipetting rules and custom labware for the Steel Lab Opentrons Flex.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/write-fixtures.ts",
    "simulate": "bash scripts/simulate.sh",
    "check": "tsc -b --force && oxlint src && vitest run",
    "protocol:new": "node --import tsx scripts/new-protocol.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.12"
  }
}
